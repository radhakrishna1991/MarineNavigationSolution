{
  "name": "assured-marine-navigation",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "iSpatialTec Assured Marine Navigation Platform - resilient PNT / GNSS-denied navigation decision support",
  "license": "UNLICENSED",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "install:all": "npm install",
    "db:migrate": "npm run db:migrate --workspace backend",
    "db:seed": "npm run db:seed --workspace backend",
    "db:reset": "npm run db:reset --workspace backend",
    "dev:backend": "npm run dev --workspace backend",
    "dev:frontend": "npm run dev --workspace frontend",
    "dev": "concurrently -n backend,frontend -c cyan,magenta \"npm:dev:backend\" \"npm:dev:frontend\"",
    "build": "npm run build --workspace frontend",
    "start": "npm run start --workspace backend",
    "test": "npm run test --workspace backend && npm run test --workspace frontend",
    "test:backend": "npm run test --workspace backend",
    "test:frontend": "npm run test --workspace frontend",
    "generate:data": "node scripts/generate_demo_data.js",
    "run:scenario": "node scripts/run_scenario.js",
    "export:results": "node scripts/export_results.js",
    "seed:database": "node scripts/seed_database.js"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
