<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS configuration for the Assured Marine Navigation Platform, deployed as the
  application `MNS` under Default Web Site.

  Two kinds of request arrive here and they are handled differently:

    /MNS/api/...  and  /MNS/ws/live   go to Node, through iisnode
    everything else                   is the React dashboard, served as files

  The dashboard is a single-page application, so any path that is not a file
  must return `index.html` and let the client router resolve it - otherwise a
  refresh on /MNS/alarms is a 404.
-->
<configuration>
  <system.webServer>

    <handlers>
      <!-- Only this one file is executed by Node. Nothing else in the tree is. -->
      <add name="iisnode" path="app.js" verb="*" modules="iisnode" />
    </handlers>

    <!--
      iisnode performs the WebSocket upgrade itself, so IIS's own WebSocket
      module has to stand aside. With this left enabled the module answers the
      upgrade first and the live stream never reaches Node.
    -->
    <webSocket enabled="false" />

    <!--
      nodeProcessCommandLine: EDIT THIS if Node is not in the default location
      on the target server. Confirm the path there with:

          (Get-Command node).Source

      A wrong path is a blank HTTP 500 with an empty iisnode\ folder - Node
      never starts, so it never logs anything.
    -->
    <iisnode
      nodeProcessCommandLine="&quot;C:\Program Files\nodejs\node.exe&quot;"

      nodeProcessCountPerApplication="1"

      watchedFiles="web.config;app.js"

      loggingEnabled="true"
      logDirectory="iisnode"
      maxLogFileSizeInKB="1024"
      maxTotalLogFileSizeInKB="20480"
      maxLogFiles="20"

      devErrorsEnabled="true"

      gracefulShutdownTimeout="15000"
      maxConcurrentRequestsPerProcess="1024"
      maxNamedPipeConnectionRetry="100"
      namedPipeConnectionRetryDelay="250"
      />

    <rewrite>
      <rules>

        <!--
          The API and the live stream. `stopProcessing` matters: without it the
          static rules below would run afterwards and rewrite the request again.
        -->
        <rule name="MNS: API and WebSocket to Node" stopProcessing="true">
          <match url="^(api|ws)(/.*)?$" />
          <action type="Rewrite" url="app.js" />
        </rule>

        <!-- Never serve the server's own files, whatever the URL asks for. -->
        <rule name="MNS: block server internals" stopProcessing="true">
          <match url="^(backend|node_modules|iisnode|data|logs)(/.*)?$" />
          <action type="CustomResponse" statusCode="404" statusReason="Not Found"
                  statusDescription="Not Found" />
        </rule>

        <!-- The application root. -->
        <rule name="MNS: root document" stopProcessing="true">
          <match url="^$" />
          <action type="Rewrite" url="public/index.html" />
        </rule>

        <!--
          Static assets, matched on a known extension rather than on "contains a
          dot". The looser test would send a client route that happens to carry
          a dot - a vessel identifier in a path segment, say - to the static
          handler and produce a 404 instead of the dashboard. This list is
          everything a Vite build can emit, so anything outside it is a route.
        -->
        <rule name="MNS: static assets" stopProcessing="true">
          <match url="^.*\.(js|mjs|css|map|json|txt|xml|ico|png|jpe?g|gif|svg|webp|avif|woff2?|ttf|otf|eot|wasm|webmanifest|pdf|csv|mp4|webm)$" />
          <action type="Rewrite" url="public/{R:0}" />
        </rule>

        <!-- Anything left is a client route: hand back the application shell. -->
        <rule name="MNS: single-page application fallback" stopProcessing="true">
          <match url=".*" />
          <action type="Rewrite" url="public/index.html" />
        </rule>

      </rules>
    </rewrite>

    <security>
      <requestFiltering>
        <!-- Belt and braces: these are already unreachable through the rules above. -->
        <hiddenSegments>
          <add segment="backend" />
          <add segment="node_modules" />
          <add segment="iisnode" />
          <add segment="data" />
        </hiddenSegments>
        <fileExtensions>
          <add fileExtension=".env" allowed="false" />
          <add fileExtension=".yaml" allowed="false" />
          <add fileExtension=".yml" allowed="false" />
        </fileExtensions>
        <!-- Sensor uploads and scenario imports; the API enforces its own limit too. -->
        <requestLimits maxAllowedContentLength="8388608" />
      </requestFiltering>
    </security>

    <!--
      MIME types are deliberately not declared here. Which ones IIS already
      knows varies by version and by what else is installed, and declaring one
      that is already present is a 500.19 that takes the whole application down
      rather than a harmless duplicate. setup-iis.ps1 adds the missing ones
      after checking, which is the only way to be both correct and idempotent.

      Client caching is left at the IIS default - revalidation against ETag and
      Last-Modified. A bridge display is typically left open for days, and a
      stale bundle surviving a redeployment is a worse failure than a 304 on
      each load.
    -->

    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="SAMEORIGIN" />
        <add name="Referrer-Policy" value="no-referrer" />
      </customHeaders>
    </httpProtocol>

    <!-- Node sets its own status codes and JSON error bodies. Without this IIS
         replaces them with its own error pages, and an API client gets HTML
         where it expected a documented error shape. -->
    <httpErrors existingResponse="PassThrough" />

  </system.webServer>
</configuration>
