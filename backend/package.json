{
  "name": "@amnp/backend",
  "version": "1.0.0",
  "private": true,
  "description": "Assured Marine Navigation Platform - backend (modular monolith)",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "db:migrate": "node src/db/migrate.js",
    "db:seed": "node src/db/seed.js",
    "db:reset": "node src/db/migrate.js --drop && node src/db/seed.js",
    "test": "node --experimental-vm-modules ./scripts/jest.js --runInBand",
    "test:watch": "node --experimental-vm-modules ./scripts/jest.js --watch"
  },
  "dependencies": {
    "bcryptjs": "2.4.3",
    "compression": "1.7.4",
    "cors": "2.8.5",
    "dotenv": "16.4.5",
    "express": "4.21.2",
    "express-rate-limit": "7.4.1",
    "helmet": "8.0.0",
    "jsonwebtoken": "9.0.2",
    "pg": "8.13.1",
    "uuid": "11.0.3",
    "ws": "8.18.0",
    "yaml": "2.6.1",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "jest": "29.7.0",
    "supertest": "7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "transform": {},
    "testMatch": [
      "<rootDir>/tests/**/*.test.js"
    ],
    "setupFiles": [
      "<rootDir>/tests/setup.js"
    ],
    "testTimeout": 180000,
    "maxWorkers": 1
  }
}
