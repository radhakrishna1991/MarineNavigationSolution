# ---------------------------------------------------------------------------
# iSpatialTec Assured Marine Navigation Platform - environment configuration
# Copy to `.env` and adjust. NEVER commit a populated `.env`.
# ---------------------------------------------------------------------------

# ---- Runtime -------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info
TZ=UTC

# ---- Backend HTTP / WebSocket -------------------------------------------
BACKEND_PORT=4000
# `::` binds all interfaces on both address families, so `localhost` works
# whether it resolves to 127.0.0.1 or ::1. Use 127.0.0.1 to bind loopback only.
BACKEND_HOST=::
# Comma separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173,http://localhost:4173,http://localhost:8080

# ---- PostgreSQL ----------------------------------------------------------
PGHOST=localhost
PGPORT=5432
PGDATABASE=marinenavigation
PGUSER=AIUSER
PGPASSWORD=CHANGE_ME
PGSSL=false
PG_POOL_MAX=20
PG_IDLE_TIMEOUT_MS=30000

# ---- Security ------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING
JWT_EXPIRES_IN=8h
JWT_ISSUER=ispatialtec-amnp
# Seed password for the bootstrap administrator (only used by `npm run db:seed`)
SEED_ADMIN_PASSWORD=CHANGE_ME
SEED_DEMO_PASSWORD=CHANGE_ME
# Set to `true` to allow unauthenticated read-only access to the demo dashboard
ALLOW_ANONYMOUS_VIEWER=false

# ---- Rate limiting -------------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=600
INGEST_RATE_LIMIT_MAX=6000
MAX_REQUEST_BODY_BYTES=2097152

# ---- Simulated UDP sensor ingestion -------------------------------------
UDP_INGEST_ENABLED=true
UDP_INGEST_PORT=5005
UDP_INGEST_BIND=127.0.0.1

# ---- Recording -----------------------------------------------------------
# Persist every normalized sensor message (high volume) or downsample
RECORD_SENSOR_MESSAGES=true
RECORD_SENSOR_DECIMATION=1
RECORDER_FLUSH_MS=1000
RECORDER_MAX_BUFFER=5000

# ---- Frontend (build time, Vite) ----------------------------------------
# Normally leave these unset. The dashboard defaults to relative URLs, which the
# Vite dev server proxies to the backend in development and nginx proxies in the
# container - one origin, so CORS and WebSocket upgrades behave the same in both.
#
# Set them only to point the dashboard at a backend on a different origin. Vite
# reads its environment from the `frontend/` directory, NOT from this file, so
# they belong in `frontend/.env` or in the build environment; setting them here
# has no effect.
# VITE_API_BASE_URL=https://amnp-api.example.com
# VITE_WS_URL=wss://amnp-api.example.com/ws/live
